{
  "name": "tiktok4k",
  "version": "1.0.0",
  "description": "Social Video Quality Optimizer",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:server": "tsx src/server.ts",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 NODE_OPTIONS=\"--import tsx\" electron src/main/main.ts",
    "compile": "prisma generate && vite build && tsc",
    "package": "npm run compile && electron-builder",
    "analyze": "tsx src/test-analyzer.ts",
    "render": "tsx src/test-renderer.ts",
    "quality": "tsx src/test-quality.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "server": "tsx src/server.ts",
    "bot": "tsx src/bot.ts",
    "worker": "tsx src/worker.ts",
    "cleanup:telegram": "node scripts/cleanup-telegram-storage.cjs",
    "cleanup:telegram:dry": "cross-env TELEGRAM_CLEANUP_DRY_RUN=1 node scripts/cleanup-telegram-storage.cjs",
    "cleanup:processing": "node scripts/cleanup-processing-temp.cjs",
    "cleanup:processing:dry": "cross-env PROCESSING_TEMP_CLEANUP_DRY_RUN=1 node scripts/cleanup-processing-temp.cjs",
    "telegram:up": "docker compose -f docker-compose.telegram.yml up -d",
    "telegram:down": "docker compose -f docker-compose.telegram.yml down",
    "telegram:logs": "docker compose -f docker-compose.telegram.yml logs -f telegram-bot-api"
  },
  "build": {
    "appId": "com.dinislam.tiktok4k",
    "productName": "TikTok4K Optimizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/preload.cjs"
    ],
    "extraResources": [
      {
        "from": "binaries",
        "to": "binaries"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "bullmq": "^6.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.45.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yt-dlp-exec": "^1.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0",
    "prisma": "^6.19.3"
  }
}
