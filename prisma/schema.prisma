generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CreditSource {
  FREE
  REFERRAL
  PURCHASE
}

enum PurchasePackage {
  STARTER
  STANDARD
  PRO
}

enum PurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id             String        @id @default(uuid())
  telegramId     BigInt        @unique
  username       String?
  language       String        @default("kk")
  bonusLimit     Int           @default(0)
  referralCode   String        @unique @default(cuid())
  isBanned       Boolean       @default(false)
  banReason      String?
  bannedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  authSessions  AuthSession[]
  devices       Device[]
  creditLots    CreditLot[]
  purchases     Purchase[]
  referralsSent Referral[]     @relation("ReferralSender")
  referralReceived Referral?   @relation("ReferralReceiver")
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String    @default("free")
  status    String    @default("active")
  startedAt DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid())
  sessionId String   @unique
  status    String   @default("PENDING")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String   @unique
  name       String?
  platform   String?
  lastSeenAt DateTime @default(now())
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usageRecords UsageRecord[]
}

model CreditLot {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      CreditSource
  quantity    Int
  remaining   Int
  expiresAt   DateTime?
  purchaseId  String?      @unique
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  referralId  String?      @unique
  referral    Referral?    @relation(fields: [referralId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  usageRecords UsageRecord[]

  @@index([userId, source, expiresAt])
  @@index([userId, remaining])
}

model Purchase {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  package     PurchasePackage
  videos      Int
  priceKzt    Int
  status      PurchaseStatus  @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creditLot   CreditLot?

  @@index([userId, status, createdAt])
}

model Referral {
  id              String     @id @default(uuid())
  referrerId      String
  referrer        User       @relation("ReferralSender", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId  String     @unique
  referredUser    User       @relation("ReferralReceiver", fields: [referredUserId], references: [id], onDelete: Cascade)
  bonusGranted    Boolean    @default(false)
  createdAt       DateTime   @default(now())
  bonusGrantedAt  DateTime?

  creditLot       CreditLot?

  @@index([referrerId, createdAt])
}

model UsageRecord {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  creditLotId String?
  creditLot   CreditLot? @relation(fields: [creditLotId], references: [id], onDelete: SetNull)
  status      String     @default("RUNNING")
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([creditLotId, status])
}
