# Production environment template
# Copy to .env on the VPS and fill in real values.
# NEVER commit the real .env file.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
VITE_API_URL=https://YOUR_PUBLIC_API_DOMAIN
PORT=3000
LOCAL_API_URL=http://telegram-bot-api:8081
REDIS_URL=redis://redis:6379
TELEGRAM_API_ID=REPLACE_WITH_TELEGRAM_API_ID
TELEGRAM_API_HASH=REPLACE_WITH_TELEGRAM_API_HASH
ADMIN_TELEGRAM_IDS=REPLACE_WITH_YOUR_TELEGRAM_ID
ADMIN_USERNAME=D1mawik
NODE_ENV=production
